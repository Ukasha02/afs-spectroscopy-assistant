# Copy to .env and fill in. Never commit .env.

# --- LLM (read by src/afs_assistant/llm.py; logged with every output) ---
LLM_PROVIDER=gemini             # gemini (openrouter / claude planned for model comparison)
LLM_MODEL=gemini-3.8-flash
LLM_THINKING_LEVEL=medium       # minimal | low | medium | high  (try high for final runs)
LLM_MAX_OUTPUT_TOKENS=16384
LLM_SEED=42

GEMINI_API_KEY=
