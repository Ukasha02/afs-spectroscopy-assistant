# Copy to .env and fill in. Never commit .env.

# --- Provider ---------------------------------------------------------------
LLM_PROVIDER=anthropic          # anthropic | gemini (fallback)
ANTHROPIC_API_KEY=

# Per-stage models and effort (adaptive thinking depth: low | medium | high)
MODEL_INTAKE=claude-haiku-5-5
MODEL_CRITIC=claude-haiku-5-5
MODEL_ASSESS=claude-opus-5-5     # final model (chosen in the model comparison); claude-haiku-5-5 for cheap dev runs
MODEL_REVISE=claude-opus-5-5
EFFORT_INTAKE=low
EFFORT_CRITIC=low
EFFORT_ASSESS=medium
EFFORT_REVISE=medium
LLM_MAX_OUTPUT_TOKENS=16000

# --- Budget -----------------------------------------------------------------
BUDGET_LIMIT_USD=55             # calls that could exceed this are refused (ledger: outputs/spend.json)
SPEND_PHASE=dev                 # label for ledger entries; override with --phase

# --- Web app ------------------------------------------------------------------
LIVE_ENABLED=false              # true enables live runs in the app (needs ACCESS_CODE)
ACCESS_CODE=
LIVE_RUNS_PER_SESSION=3

# --- Gemini fallback (LLM_PROVIDER=gemini) ------------------------------------
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_SEED=42
